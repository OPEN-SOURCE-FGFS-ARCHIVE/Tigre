<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>interior.ac</path>
  <animation>
  <type>range</type>
  <min-m>0</min-m>
  <max-m>400</max-m>
 </animation>

  <animation>
    <!-- Objets opaques -->
    <object-name>interieur</object-name>
    <object-name>inttour</object-name>
    <object-name>fond</object-name>
    <object-name>siegeavant</object-name>
    <object-name>siegearriere</object-name>
</animation>
    
   <!-- transparent bits -->
  <animation>
    <type>shader</type>
    <shader>chrome</shader>
    <texture>Aircraft/Generic/Effects/glass_shader.png</texture>
    <object-name>intvitres</object-name>
  </animation>
	
	<effect>
      <inherits-from>Effects/model-transparent</inherits-from>
      <object-name>intvitres</object-name>
   </effect>

  


  <animation>
    <type>noshadow</type>
     <object-name>intvitres</object-name>
  </animation>

  <!-- Planche de bord -->
  <model>
    <path>Aircraft/Tigre/Models/Interior/Panel/panel.xml</path>
    <offsets>
      <x-m> -3.994 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.057 </z-m>
      <roll-deg>    0 </roll-deg>
      <pitch-deg>   0 </pitch-deg>
      <heading-deg> 0 </heading-deg>
    </offsets>
  </model>

  <!-- Pilote -->
  <model>
  <name>pilot</name>
    <path>Aircraft/Tigre/Models/pilots/pilot.xml</path>
    <offsets>
      <x-m> -3.9 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.413 </z-m>
    </offsets>
  </model>

  <!-- Tireur -->
  <model>
  <name>gunner</name>
    <path>Aircraft/Tigre/Models/pilots/pilot.xml</path>
    <offsets>
      <x-m> -2.3 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.004 </z-m>
    </offsets>
  </model>

</PropertyList>

