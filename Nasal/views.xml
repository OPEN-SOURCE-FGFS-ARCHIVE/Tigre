<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <chase-distance-m type="double" archive="y"> -15 </chase-distance-m>
  
  <view n="0">
    <internal archive="y">true</internal>
    <config>
	  <x-offset-m archive="y">  0.000 </x-offset-m> <!--right-->
      <y-offset-m archive="y">  0.94 </y-offset-m> <!--up-->
      <z-offset-m archive="y"> -2.711 </z-offset-m> <!--back-->
      <pitch-offset-deg> -10 </pitch-offset-deg>
      <default-field-of-view-deg> 84 </default-field-of-view-deg>
    </config>
  </view>

  <view n="100">
    <name>Gunner</name>
    <type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01f</ground-level-nearplane-m>
      <pitch-offset-deg>-5</pitch-offset-deg>
      <x-offset-m archive="y">  0.000 </x-offset-m>	<!-- Right -->
      <y-offset-m archive="y">  1.507 </y-offset-m>	<!-- Up    -->
      <z-offset-m archive="y"> -1.318 </z-offset-m>	<!-- Back  -->
      <pitch-offset-deg> -5 </pitch-offset-deg>
      <default-field-of-view-deg> 70 </default-field-of-view-deg>
	  <limits>
	   <left>
	     <heading-max-deg>-100</heading-max-deg>
         <x-offset-threshold-deg>0</x-offset-threshold-deg>
         <x-offset-max-m>0</x-offset-max-m>
       </left>
       <right>
         <heading-max-deg>100</heading-max-deg>
         <x-offset-threshold-deg>0</x-offset-threshold-deg>
         <x-offset-max-m>0</x-offset-max-m>
       </right>
      <enabled>1</enabled>
     </limits>
    </config>
  </view>
  
  
  <view n="101">
    <name>TILAD</name>
    <type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01f</ground-level-nearplane-m>
      <pitch-offset-deg>-5</pitch-offset-deg>
      <x-offset-m archive="y">  0.000 </x-offset-m>	<!-- Right -->
      <y-offset-m archive="y">  1.9 </y-offset-m>	<!-- Up    -->
      <z-offset-m archive="y"> -1.4 </z-offset-m>	<!-- Back  -->
      <pitch-offset-deg> -15.000 </pitch-offset-deg>
      <default-field-of-view-deg>40</default-field-of-view-deg>
	  <limits>
	   <left>
	    <heading-max-deg>-110</heading-max-deg>
        <x-offset-threshold-deg>0</x-offset-threshold-deg>
        <x-offset-max-m>0</x-offset-max-m>
       </left>
       <right>
        <heading-max-deg>110</heading-max-deg>
        <x-offset-threshold-deg>0</x-offset-threshold-deg>
        <x-offset-max-m>0</x-offset-max-m>
        </right>
      <enabled>1</enabled>
     </limits>
    </config>
	</view>

  <view n="102">
    <name>Tail Camera View</name>
    <type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01f</ground-level-nearplane-m>
      <x-offset-m archive="y">  0.000 </x-offset-m> <!--Right-->
      <y-offset-m archive="y">  2.4 </y-offset-m> <!--Up-->
      <z-offset-m archive="y"> 7.637 </z-offset-m> <!--Back-->
      <pitch-offset-deg> -5 </pitch-offset-deg>
      <default-field-of-view-deg type="double"> 30 </default-field-of-view-deg>
    </config>
  </view>
  
  
  	
		 <view n="103">
    <name>Pilot cam</name>
        <internal archive="y">false</internal>
        <config>
		 <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
        <x-offset-m archive="y">  -0.23 </x-offset-m> <!--right-->
      <y-offset-m archive="y">  0.94 </y-offset-m> <!--up-->
      <z-offset-m archive="y"> -3.1 </z-offset-m> <!--back-->
          <pitch-offset-deg>-0</pitch-offset-deg>
		  <heading-offset-deg>199</heading-offset-deg>
          <default-field-of-view-deg>110</default-field-of-view-deg>
        </config>
     
  </view>
  
  
  	<view n="104">
			<name>Over the shoulder</name>
			<internal archive="y">false</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				 <x-offset-m archive="y">  0.27 </x-offset-m> <!--right-->
      <y-offset-m archive="y">  1.25 </y-offset-m> <!--up-->
      <z-offset-m archive="y"> -2.1 </z-offset-m> <!--back-->
				<pitch-offset-deg>-20</pitch-offset-deg>
				<heading-offset-deg>15</heading-offset-deg>
				<default-field-of-view-deg>65</default-field-of-view-deg>
			</config>
		</view>

  

  <view n="1">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="2">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="3">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="4">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="5">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="6">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

</PropertyList>
